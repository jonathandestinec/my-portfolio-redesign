# Optional. A read-only, scopeless GitHub personal access token (no scopes ticked).
# Without it the contribution grid reads your public calendar from github.com;
# labelled sample data is shown only if that also fails.
GITHUB_TOKEN=

# Public origin of the deployed site, no trailing slash. Used for canonical URLs,
# sitemap, robots, RSS, Open Graph and the résumé PDF. Empty falls back to https://destinejc.vercel.app.
NEXT_PUBLIC_SITE_URL=https://destinejc.vercel.app

# Admin panel (see README "Editing content"). Without these the admin addresses answer 404.
ADMIN_ENTRY_PATH=
ADMIN_GATE_TOKEN=
KEYSTATIC_SECRET=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Client proposals (see README "Client proposals"). Without DATABASE_URL the
# proposal pages show "no longer available" and /desk says it isn't set up.
# Use a non-production Neon branch locally: the e2e tests write to it.
DATABASE_URL=
# Your GitHub account id: the only account allowed into /desk (signed in through Studio).
ADMIN_GITHUB_ID=
# 32+ random characters: signs passcode cookies and hashes viewer IPs.
PROPOSALS_SECRET=
# Private Vercel Blob store for logos, signatures and signed PDFs. Empty = files go to .data/ on disk.
BLOB_READ_WRITE_TOKEN=
# Email to you when a proposal is opened or signed.
RESEND_API_KEY=
PROPOSALS_NOTIFY_EMAIL=
# Optional, once you verify a domain in Resend, e.g. "Destine <proposals@yourdomain.com>".
PROPOSALS_FROM_EMAIL=
