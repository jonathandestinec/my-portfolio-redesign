# Optional. A read-only, scopeless GitHub personal access token (no scopes ticked).
# Without it the contribution grid reads your public calendar from github.com;
# labelled sample data is shown only if that also fails.
GITHUB_TOKEN=

# Public origin of the deployed site, no trailing slash. Used for canonical URLs,
# sitemap, robots, RSS, Open Graph and the résumé PDF. Empty falls back to https://destinejc.vercel.app.
NEXT_PUBLIC_SITE_URL=https://destinejc.vercel.app
